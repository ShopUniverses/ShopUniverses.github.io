# ========================================================
# SHOPUNIVERSES — VARIABLES DE ENTORNO
# ========================================================
PORT=3000
HOST=127.0.0.1
SITE_URL=http://localhost:3000
NODE_ENV=development

# Credenciales de Administrador inicial
ADMIN_EMAIL=admin@shopuniverses.com
ADMIN_PASSWORD=CambiarEstaClaveSegura2026!
SESSION_SECRET=super_secret_session_key_shopuniverses_2026

# ========================================================
# GOOGLE FIREBASE (Firestore)
# ========================================================
# En local puedes usar FIREBASE_SERVICE_ACCOUNT_PATH='serviceAccountKey.json'
# En Netlify/producción puedes pasar las variables individuales:
# Opción 1 (local): ruta al JSON de la cuenta de servicio (NUNCA subirlo a Git)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# Opción 2 (Netlify): variables individuales
FIREBASE_PROJECT_ID=shopuniverses-inventario
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ========================================================
# PASARELA DE PAGO: WOMPI (BANCOLOMBIA)
# ========================================================
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxx

# ========================================================
# DATOS DE COMERCIO (COLOMBIA / LEY 1480 DE 2011)
# ========================================================
STORE_NAME=ShopUniverses
STORE_NIT=
