<%- include('partials/head', { title: null, activeNav: 'inicio' }) %>

<header class="container section">
    <div style="display:flex; justify-content:center; align-items:center; gap:32px; text-align:left;">
        <a href="/">
            <img
                src="/assets/img/perfil/2.webp"
                alt="Logo <%= store.name %>"
                class="logo-header"
                style="max-width:180px;"
                loading="lazy"
            >
        </a>
        <div>
            <h1 style="margin:0; font-size:2.8rem; letter-spacing:1px;">
                SHOPUNIVERSES
            </h1>
            <p style="margin:8px 0 0; font-size:1.15rem; line-height:1.5;">
                Importaciones • Experiencias • Productos únicos<br>
                Compra el universo, un producto a la vez.
            </p>
        </div>
    </div>
</header>

<main class="container">
    <section class="section">
        <div class="card">
            <h2>🎡 Prueba nuestra Ruleta</h2>
            <p>
                Por <strong>$25.000 COP</strong> recibe
                <strong>5 productos sorpresa</strong> seleccionados del universo ShopUniverses.
            </p>
            <button id="btnIrSpin" type="button">Ir a la Ruleta</button>
        </div>
    </section>

    <section class="section">
        <div class="card">
            <h2>🛍️ Catálogo</h2>
            <p>
                ¿Prefieres elegir tus productos uno a uno?
                Explora nuestro catálogo completo.
            </p>
            <button id="btnIrCatalogo" type="button">Ver Catálogo</button>
        </div>
    </section>
</main>

<%- include('partials/foot', { scripts: ['/assets/js/data.js', '/assets/js/carrito.js', '/assets/js/main.js'] }) %>
