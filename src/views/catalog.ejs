<%- include('partials/head', { title: 'Catálogo', activeNav: 'catalogo' }) %>

<header class="container section">
    <div class="hero-header">
        <a href="/">
            <img
                src="/assets/img/perfil/2.webp"
                alt="Logo <%= store.name %>"
                class="logo-header"
                style="max-width:180px;"
                loading="lazy"
            >
        </a>
        <div>
            <h1 style="margin:0; font-size:2.6rem; letter-spacing:1px;">
                🌌 Catálogo ShopUniverses
            </h1>
            <p style="margin:8px 0 0; font-size:1.15rem; line-height:1.5;">
                Explora nuestros productos disponibles<br>
            </p>
        </div>
    </div>
</header>

<main class="container">
    <div id="categoria-filtros" class="catalog-toolbar">
        <input
            id="filtro-busqueda"
            type="search"
            placeholder="Buscar producto en el universo..."
            aria-label="Buscar producto"
        >

        <select id="filtro-categoria" aria-label="Filtrar por categoría">
            <option value="" data-categoria="">Todas las categorías</option>
            <% if (categories && categories.length > 0) { categories.forEach(function (cat) { %>
            <option value="<%= cat %>" data-categoria="<%= cat %>"><%= cat %></option>
            <% }); } %>
        </select>

        <select id="filtro-orden" aria-label="Ordenar productos">
            <option value="relevancia">Ordenar: Destacados</option>
            <option value="precio-asc">Precio: Menor a Mayor</option>
            <option value="precio-desc">Precio: Mayor a Menor</option>
            <option value="nombre-asc">Nombre: A - Z</option>
        </select>

        <small id="catalogo-contador" class="catalog-toolbar__count"></small>
    </div>

    <section id="catalogo" class="grid"></section>
</main>

<%- include('partials/foot', { scripts: ['/assets/js/data.js', '/assets/js/carrito.js', '/assets/js/main.js', '/assets/js/catalogo.js'] }) %>
