<%- include('partials/head', { title: 'Carrito', activeNav: 'carrito' }) %>

<header class="container section">
    <div class="hero-header">
        <a href="/">
            <img
                src="/assets/img/perfil/2.webp"
                alt="Logo <%= store.name %>"
                class="logo-header"
                style="max-width:120px;"
                loading="lazy"
            >
        </a>
        <div>
            <h1 style="margin:0; font-size:2.8rem; letter-spacing:1px;">TU CARRITO</h1>
            <p style="margin:8px 0 0; font-size:1.15rem; line-height:1.5; color: var(--color-text-muted);">
                Revisa tu pedido estelar antes de confirmar tu compra.
            </p>
        </div>
    </div>
</header>

<main class="container section">
    <div class="layout-sidebar">
        <section class="card">
            <h3>Productos en el pedido</h3>
            <hr style="border: 0; border-top: 1px solid var(--color-border); margin: 20px 0;">
            <ul id="lista-carrito" style="list-style: none; padding: 0;"></ul>
        </section>

        <aside class="card sticky-panel">
            <h3>Resumen</h3>
            <div class="flex-between" style="margin: 20px 0; font-size: 1.4rem;">
                <span>Total:</span>
                <strong style="color: var(--color-accent);">$<span id="total">0</span></strong>
            </div>

            <div class="producto-accion" style="display: flex; flex-direction: column; gap: 10px;">
                <button id="btn-ir-checkout" type="button">🚀 Finalizar Compra / Pagar</button>
                <button id="btn-enviar-wa" class="secondary" type="button">✦ Enviar por WhatsApp</button>
                <button id="btn-vaciar" class="secondary" type="button">Vaciar Carrito</button>
            </div>

            <div id="log" style="margin-top: 20px; font-size: 0.8rem; color: var(--color-text-muted);"></div>
        </aside>
    </div>
</main>

<%- include('partials/foot', { scripts: ['/assets/js/main.js', '/assets/js/carrito.page.js'] }) %>
